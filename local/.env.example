# Sunucu Portu (Varsayılan: 3000)
PORT=3000

# Firebase Auth isteğe bağlıdır. Boş bırakılırsa mevcut firebase-config.js okunur;
# ikisi de yoksa tek kullanıcılı yerel mod kullanılır.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Yalnız güvenilir yerel ağda kimlik doğrulamayı kapatmak için true.
DISABLE_AUTH=false

# OCR: auto seçili CUDA varsa GPU'yu, yoksa CPU'yu kullanır.
# cuda GPU'yu zorunlu kılar; cpu GPU kullanımını kapatır.
OCR_DEVICE=auto

# Yavaş CPU sayfaları için model isteği zaman aşımı (milisaniye).
OCR_REQUEST_TIMEOUT_MS=1800000
