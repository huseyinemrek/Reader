# Copy to vps/.env. This file is loaded regardless of launch directory.
HOST=127.0.0.1
PORT=3000
# Optional absolute directory; default is the vps folder, independently of local data.
# DATA_DIR=/home/ubuntu/reader/vps

# Copy the Firebase web app settings used by your existing Reader deployment.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
DISABLE_AUTH=false

# Computer mode remains disabled until a random secret of at least 32 characters is set.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_SECRET=
OCR_LEASE_SECONDS=300
# CPU pages can take more than 13 minutes; default request timeout is 30 minutes.
OCR_REQUEST_TIMEOUT_MS=1800000
# Existing CPU environment is retained at local/.venv-ocr by default.
# OCR_PYTHON=/home/ubuntu/reader/local/.venv-ocr/bin/python
# OCR_DEVICE is always cpu on the VPS; computer worker CUDA settings are separate.
