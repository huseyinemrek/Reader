# Copy to compute/.env. Never commit the real bearer secret.
VPS_URL=https://reader.example.com
WORKER_SECRET=replace-with-the-same-long-random-secret-as-the-vps
# Mandatory: the home worker does not support CPU or automatic fallback.
OCR_DEVICE=cuda

VPS_CONNECT_TIMEOUT_SECONDS=15
VPS_READ_TIMEOUT_SECONDS=120
VPS_WRITE_TIMEOUT_SECONDS=120
VPS_DELIVERY_ATTEMPTS=3

# HTTPS is mandatory in production. Loopback HTTP needs no override for smoke.
# Unsafe plaintext non-loopback HTTP is only for isolated temporary development.
ALLOW_UNSAFE_HTTP=false

# Optional: for a VPS that currently exposes HTTP only, use encrypted outbound
# SSH instead. SSH_HOST overrides VPS_URL; the local forwarding port is automatic.
# OpenSSH must be installed and the VPS host key already verified in known_hosts.
SSH_HOST=
SSH_USER=ubuntu
SSH_KEY_FILE=
SSH_PORT=22
SSH_REMOTE_PORT=3000
